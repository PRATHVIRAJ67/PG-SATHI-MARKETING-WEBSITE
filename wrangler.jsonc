{
  // Static marketing site on Cloudflare Workers (assets only, no server code).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pg-sathi-website",
  "compatibility_date": "2026-10-01",
  // Keep the workers.dev address alive next to the custom domain.
  "workers_dev": true,
  // Needs pgsathi.online to be Active in Cloudflare before the next deploy.
  "routes": [
    { "pattern": "pgsathi.online", "custom_domain": true },
    { "pattern": "www.pgsathi.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Unknown paths return public/404.html with a real 404 status, so search engines drop them.
    "not_found_handling": "404-page"
  }
}
